{
  "name": "loopy-reminders",
  "version": "1.0.0",
  "description": "A private, playful reminder app for mobile and desktop.",
  "author": "yathinm",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "desktop": "concurrently -k -s first \"expo start --web --port 8081\" \"wait-on http://127.0.0.1:8081 && electron electron/main.cjs --dev-url=http://127.0.0.1:8081\"",
    "desktop:web": "expo export --platform web --output-dir dist-web",
    "desktop:pack": "npm run desktop:web && electron-builder --dir",
    "desktop:build": "npm run desktop:web && electron-builder",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "validate": "npm run typecheck && npm run lint && npm test",
    "android": "expo run:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "typescript": "~5.9.2",
    "wait-on": "^9.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ]
  },
  "build": {
    "appId": "com.yathinm.loopyreminders.desktop",
    "productName": "Loopy Reminders",
    "artifactName": "Loopy-Reminders-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist-web/**/*",
      "assets/desktop/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/desktop/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "assets/desktop/icon.png",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "Loopy-Reminders-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Loopy-Reminders-Portable-${version}-${arch}.${ext}"
    }
  }
}
